# 本地开发环境变量（勿提交进 git）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=tracker

JWT_SECRET=dev-secret-change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8081/api/auth/feishu/callback
# 开发态 mock 登录，凭证到位改 false
FEISHU_MOCK_LOGIN=false
WEB_FRONT_URL=http://localhost:5173
# 项目群每日简报目标群 chat_id（oc_ 开头，机器人需已在群内）；空则工作日 09:00 不发
FEISHU_BRIEF_GROUP_CHAT_ID=
# 简报图表使用系统中文字体；Linux 安装 fonts-noto-cjk，或指定可读取的中文字体文件
FEISHU_BRIEF_FONT_PATH=

# ===== 智能体查询（docs/16 §3.2）=====
# true 时启用智能体（大模型把任意问法翻译成只读工具调用）；false 保持一期关键词引擎（默认关，保证不回归）
# 数据会发给外网 LLM，需 IT/合规审批；换供应商只改 LLM_BASE_URL/LLM_API_KEY/LLM_MODEL
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=10000
LLM_MAX_TOKENS=1500
LLM_MAX_ROUNDS=4
# 项目群简报：true 用思考模式生成（点评更深入；更慢更耗，失败自动退回非思考）
LLM_BRIEF_THINKING=true
# 简报专用模型（留空 = 同 LLM_MODEL）；思考模式若需 reasoner 类模型在此指定
LLM_BRIEF_MODEL=
# 思考模式下的输出上限与超时（思考更耗 token、更慢）
LLM_BRIEF_MAX_TOKENS=6000
LLM_BRIEF_TIMEOUT_MS=120000
# 本地联调：填你自己的内部 user id（如 1）后，所有飞书出站通知改发给他，避免打扰真实收件人；不填=不转发
FEISHU_NOTIFY_REDIRECT_USER_ID=
# 本地联调：显式固定计划变更终审人（内部 user id，由本环境管理员配置）；不填=取“总经办”部门负责人
PLAN_FINAL_APPROVER_USER_ID=

# 本地开发默认不发送真实通知；上线前按实际用途配置
FEISHU_NOTIFY_DISABLED=true
FEISHU_GROUP_NOTIFY_DISABLED=true
FEISHU_MOCK_PASSWORD=
