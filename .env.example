# ===== Postgres =====
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me

# ===== 后端 (server) =====
# 数据库连接（容器内用 db 这个服务名）
DB_HOST=db
DB_PORT=5432
DB_USERNAME=tracker
DB_PASSWORD=change-me
DB_DATABASE=tracker

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# ===== 运维日志 =====
# Docker 部署时 compose 会映射到宿主机 ./logs/api
LOG_MAX_SIZE_MB=20
LOG_RETENTION_DAYS=30
ERROR_LOG_RETENTION_DAYS=60
SLOW_REQUEST_MS=1000

# 飞书自建应用（拿到后填这里，勿提交进 git）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# OAuth 回调地址（后端可被飞书访问到），本地开发可用内网穿透
FEISHU_REDIRECT_URI=http://localhost:8081/api/auth/feishu/callback

# 开发态 mock 登录：true 时前端可用预设用户跳过飞书，凭证到位后改 false
FEISHU_MOCK_LOGIN=false
FEISHU_MOCK_PASSWORD=

# 飞书机器人长连接：true 时启动 LarkChannel 接收消息事件。
# 前置：飞书后台开通机器人 + im:message / im:message:send_as_bot 权限
#       + 事件订阅 im.message.receive_v1 投递方式选「长连接」。
FEISHU_BOT_ENABLED=false

# ===== 前端 (web) 与部署 =====
# 内网访问 IP（用于拼接前端访问后端的绝对地址，留空则用相对 /api）
HOST_IP=
# 前端构建时注入的后端地址；nginx 反代 /api 时写 /api
VITE_API_BASE=/api

# 本地开发默认不发送真实通知；上线前按实际用途配置
FEISHU_NOTIFY_DISABLED=true
FEISHU_GROUP_NOTIFY_DISABLED=true
